{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2P Messenger",
  "version": "0.1.0",
  "identifier": "dev.p2p.messenger",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "P2P Messenger",
        "width": 440,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
