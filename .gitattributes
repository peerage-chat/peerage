# bash-скрипты должны оставаться с LF — иначе ломаются при запуске в WSL/Linux.
*.sh text eol=lf
# Go/Rust исходники — LF для единообразия между Windows и WSL.
*.go text eol=lf
*.rs text eol=lf
# Kotlin/Gradle — LF: ktlint (.editorconfig end_of_line=lf) иначе валит CRLF.
*.kt text eol=lf
*.kts text eol=lf
