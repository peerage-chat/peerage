<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider (M2): расшариваем только подпапку cache/shared для «открыть вложение». -->
<paths>
    <cache-path name="shared" path="shared/" />
    <!-- Снимок с камеры кладём сюда: системная камера пишет в него по content://. -->
    <cache-path name="camera" path="camera/" />
    <!-- Картинка с клавиатуры (GIF, стикер): своя копия, пока ждёт над полем ввода. -->
    <cache-path name="keyboard" path="keyboard/" />
</paths>
