<?xml version="1.0" encoding="utf-8"?>
<!-- Передний слой адаптивной иконки: знак акцентом. Сетка 108dp, безопасная зона — круг 66dp;
     знак 24 × 2.4 = 57.6dp по центру, как на утверждённом макете. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="25.2"
        android:translateY="25.2">
        <path
            android:pathData="@string/glyph_links"
            android:strokeWidth="2"
            android:strokeColor="@color/brand_accent"
            android:strokeLineCap="round" />
        <path
            android:fillColor="@color/brand_accent"
            android:pathData="@string/glyph_peers" />
    </group>
</vector>
