<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Сеть для Yggdrasil-пиров. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Для звонков (фаза G3): запись аудио. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Постоянный mesh-узел: foreground-сервис + локи CPU/Wi-Fi (Фаза D, режим A). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Показывать звонок поверх экрана блокировки (fullScreenIntent). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="false"
        android:label="p2p messenger"
        android:supportsRtl="true"
        android:theme="@style/Theme.P2P">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.P2P">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Держит узел Yggdrasil живым при погасшем экране (см. ConnService). -->
        <service
            android:name=".ConnService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the decentralized P2P mesh node reachable while the app is open" />
        </service>

        <!-- Ongoing-уведомление активного звонка с хронометром и кнопкой «Завершить». -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />

        <!-- Кнопки «Принять»/«Отклонить» в уведомлении о входящем звонке. -->
        <receiver
            android:name=".IncomingCallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.p2p.messenger.ACCEPT_CALL" />
                <action android:name="dev.p2p.messenger.DECLINE_CALL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
